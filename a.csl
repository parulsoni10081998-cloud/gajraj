
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US">

  <info>
    <title>Custom Author Year Journal Style</title>
    <id>http://www.zotero.org/styles/custom-author-year-journal</id>
    <link href="http://www.zotero.org/styles/custom-author-year-journal" rel="self"/>
    <author>
      <name>Custom Citation Style</name>
    </author>
    <category citation-format="author-date"/>
    <updated>2026-11-03T00:00:00+00:00</updated>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=" "
            initialize-with=""
            delimiter=", "
            and="text"/>
    </names>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="title">
    <text variable="title" text-case="sentence"/>
  </macro>

  <macro name="container">
    <text variable="container-title" form="short" font-style="italic"/>
  </macro>

  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=" ">
        <text macro="author"/>
        <text macro="issued"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true"
                et-al-min="99"
                entry-spacing="1"
                line-spacing="1">
    <sort>
      <key macro="author"/>
      <key macro="issued"/>
    </sort>
    <layout>
      <group delimiter=" ">
        <text macro="author"/>
        <group prefix="(" suffix=")">
          <text macro="issued"/>
        </group>
        <text macro="title"/>
        <group delimiter=" ">
          <text macro="container"/>
          <group delimiter=":">
            <text variable="volume"/>
            <text variable="page"/>
          </group>
        </group>
      </group>
    </layout>
  </bibliography>

</style>
